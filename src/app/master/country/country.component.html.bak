<app-breadcrumb [btnAdd]="breadcrumbFlags.btnAdd" [btnSave]="false" [btnBack]="breadcrumbFlags.btnBack" [btnReset]="breadcrumbFlags.btnReset" [btnResetTbl]="breadcrumbFlags.btnResetTbl" (eventAdd)="addStateList()" [routePath]='routePath' [btnAddDisabled]="true"
    (eventBack)=" closeForm()" (eventSave)="saveCountry()" [toolTip]="breadcrumbFlags.toolTip" (eventResetTbl)="resetTable()" (eventReset)=" resetForm()"></app-breadcrumb>

<div fxLayout="row" fxLayoutGap="20px">
    <div fxFlex="100%">
        <mat-card>

            <div fxLayout="row">
                <mat-card-header fxFlex="100%">
                    <div fxFlex="100%">
                        <div fxLayout="row" fxLayout.lg="row" fxLayout.md="row" fxLayout.sm="row" fxLayout.xs="column" fxLayoutGap="10px">
                            <div fxFlex="70%" fxFlex.lg="70%" fxFlex.md="70%" fxFlex.sm="70%" fxFlex.xs="100%" fxLayoutAlign="start center" fxLayoutAlign.sm="start center" fxLayoutAlign.xs="start center">
                                <mat-card-title>
                                    <h1 class="header-title">Country</h1>
                                </mat-card-title>
                            </div>
                            <span fxFlex></span>
                            <div fxFlex="30%" fxFlex.lg="30%" fxFlex.md="30%" fxFlex.sm="30%" fxFlex.xs="100%" fxHide.xs fxLayoutAlign="end center" fxLayoutAlign.sm="end center">
                                <div class="tbl-commonsearch" *ngIf="!showCountry">
                                    <mat-form-field fxFlex="100%">
                                        <mat-label></mat-label>
                                        <mat-icon matPrefix><i class="icon-search1"></i></mat-icon>
                                        <input matInput placeholder="Search here..." type="text" pInputText size="50" autocomplete="off" (input)="dt?.filterGlobal($event.target.value, 'contains')" />
                                    </mat-form-field>
                                </div>
                            </div>
                        </div>
                    </div>
                </mat-card-header>
            </div>
            <mat-card-content>
                <div *ngIf="showCountry" fxLayout="row wrap" fxLayout.lg="row" fxLayout.md="row" fxLayout.sm="row wrap" fxLayout.xs="column" fxLayoutGap="0px grid">
                    <div fxFlex="100%">
                        <form [formGroup]="countryFormGroup">
                            <div fxLayout="row wrap" fxLayout.lg="row" fxLayout.md="row" fxLayout.sm="column wrap" fxLayout.xs="column" fxLayoutGap="20px grid" fxLayoutGap.sm="0px grid" fxLayoutGap.xs="0px grid">
                                <div fxFlex="40%" fxFlex.lg="40%" fxFlex.md="40%" fxFlex.sm="50%" fxFlex.xs="100%">
                                    <mat-form-field appearance="outline" fxFlex="100%" autocomplete="off">
                                        <mat-label>Country Name</mat-label>
                                        <input #input formControlName="countryName" matInput placeholder="Country Name" maxlength="200" required>
                                        <mat-error *ngIf="countryFormGroup.get('countryName').invalid"> Country Name is required </mat-error>
                                    </mat-form-field>
                                </div>
                                <div fxFlex="40%" fxFlex.lg="40%" fxFlex.md="40%" fxFlex.sm="50%" fxFlex.xs="100%">
                                    <mat-form-field appearance="outline" fxFlex="100%" autocomplete="off">
                                        <mat-label>Country Code</mat-label>
                                        <input #input formControlName="code" matInput placeholder="Country Code" maxlength="10" required>
                                        <mat-error *ngIf="countryFormGroup.get('code').invalid"> Country Code is required </mat-error>
                                    </mat-form-field>
                                </div>
                                <div fxFlex="33.33%" fxFlex.lg="33.33%" fxFlex.md="33.33%" fxFlex.sm="50%" fxFlex="100%">
                                    <app-auto-complete [selectProperties]='regionControl' (selectionChange)="selectRegion($event)"> </app-auto-complete>
                                </div>
                            </div>
                            <div fxLayout="row wrap" fxLayout.lg="row" fxLayout.md="row" fxLayout.sm="column wrap" fxLayout.xs="column" fxLayoutGap="20px grid" fxLayoutGap.sm="0px grid" fxLayoutGap.xs="0px grid">
                                <div fxFlex="40%" fxFlex.lg="40%" fxFlex.md="40%" fxFlex.sm="50%" fxFlex.xs="100%">
                                    <mat-form-field appearance="outline" fxFlex="100%" autocomplete="off">
                                        <mat-label>Phone Code</mat-label>
                                        <input #input formControlName="phonecode" matInput placeholder="Phone Code" maxlength="200" required>
                                        <mat-error *ngIf="countryFormGroup.get('phonecode').invalid"> Phone Code is required </mat-error>
                                    </mat-form-field>
                                </div>
                                <div fxFlex="40%" fxFlex.lg="40%" fxFlex.md="40%" fxFlex.sm="50%" fxFlex.xs="100%">
                                    <mat-form-field appearance="outline" fxFlex="100%" autocomplete="off">
                                        <mat-label>Latitude</mat-label>
                                        <input #input formControlName="latitude" matInput placeholder="Latitude" maxlength="10">
                                    </mat-form-field>
                                </div>
                                <div fxFlex="40%" fxFlex.lg="40%" fxFlex.md="40%" fxFlex.sm="50%" fxFlex.xs="100%">
                                    <mat-form-field appearance="outline" fxFlex="100%" autocomplete="off">
                                        <mat-label>Longitude</mat-label>
                                        <input #input formControlName="longitude" matInput placeholder="Longitude" maxlength="10">
                                    </mat-form-field>
                                </div>
                            </div>
                            <div fxLayout="row wrap" fxLayout.lg="row" fxLayout.md="row" fxLayout.sm="column wrap" fxLayout.xs="column" fxLayoutGap="20px grid" fxLayoutGap.sm="0px grid" fxLayoutGap.xs="0px grid">
                                <div fxFlex="70%" fxFlex.lg="70%" fxFlex.md="70%" fxFlex.sm="70%" fxFlex.xs="100%" fxLayoutAlign="start center" fxLayoutAlign.sm="start center" fxLayoutAlign.xs="start center">
                                    <mat-card-title>
                                        <h1 class="header-title">Currency Detail</h1>
                                    </mat-card-title>
                                </div>
                            </div>
                            <div formGroupName="currency">
                                <div fxLayout="row wrap" fxLayout.lg="row" fxLayout.md="row" fxLayout.sm="column wrap" fxLayout.xs="column" fxLayoutGap="20px grid" fxLayoutGap.sm="0px grid" fxLayoutGap.xs="0px grid">
                                    <div fxFlex="40%" fxFlex.lg="40%" fxFlex.md="40%" fxFlex.sm="50%" fxFlex.xs="100%">
                                        <mat-form-field appearance="outline" fxFlex="100%" autocomplete="off">
                                            <mat-label>Currency Name</mat-label>
                                            <input #input formControlName="currencyName" matInput placeholder="Currency Name" maxlength="200" required>
                                            <mat-error *ngIf="countryFormGroup.get('currency.currencyName')?.invalid"> Currency Name is required </mat-error>
                                        </mat-form-field>
                                    </div>
                                    <div fxFlex="40%" fxFlex.lg="40%" fxFlex.md="40%" fxFlex.sm="50%" fxFlex.xs="100%">
                                        <mat-form-field appearance="outline" fxFlex="100%" autocomplete="off">
                                            <mat-label>Currency Symbol</mat-label>
                                            <input #input formControlName="currencySymbol" matInput placeholder="Currency Symbol" maxlength="10" required>
                                            <mat-error *ngIf="countryFormGroup.get('currency.currencySymbol')?.invalid"> Currency Symbol is required </mat-error>
                                        </mat-form-field>
                                    </div>
                                    <div fxFlex="40%" fxFlex.lg="40%" fxFlex.md="40%" fxFlex.sm="50%" fxFlex.xs="100%">
                                        <mat-form-field appearance="outline" fxFlex="100%" autocomplete="off">
                                            <mat-label>Currency ShortName</mat-label>
                                            <input #input formControlName="currencyShortName" matInput placeholder="Currency ShortName" maxlength="10" required>
                                            <mat-error *ngIf="countryFormGroup.get('currency.currencyShortName')?.invalid"> Currency ShortName is required </mat-error>
                                        </mat-form-field>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
                <div fxLayout="row" fxLayout.lg="row" fxLayout.md="row" fxLayout.sm="row" fxLayout.xs="column" *ngIf="!showCountry">
                    <div fxFlex="100%" fxFlex.lg="100%" fxFlex.md="100%" fxFlex.sm="100%" fxFlex.xs="100%">
                       
                        <p-table
  #dt
  [columns]="displayedColumns"
  [value]="countryList"
  [scrollable]="true"
  [resizableColumns]="true"
  [reorderableColumns]="true"
  [paginator]="true"
  [rows]="itemperpage"
  frozenWidth="150px"
  [frozenColumns]="frozenCols">

  <!-- ===== COLGROUP ===== -->
  <ng-template pTemplate="colgroup" let-colGroupCols>
    <colgroup>
      <col *ngFor="let col of colGroupCols" style="width:200px" />
    </colgroup>
  </ng-template>

  <!-- ===== HEADER ===== -->
  <ng-template pTemplate="header" let-headerCols>
    <tr>
      <th *ngFor="let col of headerCols"
          [ngSwitch]="col.field"
          pReorderableColumn
          pResizableColumn>

        <span [pSortableColumn]="col.field">
          <div class="thname">{{ col.header }}</div>

          <p-sortIcon
            *ngIf="col.field !== 'action'"
            [field]="col.field"
            ariaLabel="Activate to sort"
            ariaLabelDesc="Activate to sort in descending order"
            matTooltip="Sorting"
            matTooltipClass="accent-tooltip"
            ariaLabelAsc="Activate to sort in ascending order">
          </p-sortIcon>
        </span>

      </th>
    </tr>
  </ng-template>

  <!-- ===== BODY ===== -->
  <ng-template
    pTemplate="body"
    let-rowData
    let-index="rowIndex"
    let-bodyCols="columns">

    <tr>
      <td *ngFor="let col of bodyCols"
          [ngSwitch]="col.field"
          [ngClass]="{ 'desg-bg': col.field === 'action' }">

        <!-- ACTION -->
        <div *ngSwitchCase="'action'" fxLayout="row" class="desg-icon">
          <div fxFlex="100%" fxLayoutGap="10px">
            <mat-icon
              [ngClass]="screenAuth.viewFlag === false ? 'page-btn disabled' : ''"
              matTooltip="View"
              matTooltipClass="accent-tooltip">
              <i
                class="material-icons-outlined"
                (click)="editDetail(rowData, 'view')">
                visibility
              </i>
            </mat-icon>
          </div>
        </div>

        <!-- DATA -->
        <div *ngSwitchCase="'countryName'">{{ rowData.countryName }}</div>
        <div *ngSwitchCase="'currencyName'">{{ rowData.currencyName }}</div>
        <div *ngSwitchCase="'currencyShortName'">{{ rowData.currencyShortName }}</div>

        <!-- ACTIVE -->
        <div *ngSwitchCase="'active'" fxLayout="row" class="tbl-icon">
          <span *ngIf="rowData.active" class="istrue">
            <i matTooltip="Active" class="material-icons">thumb_up</i>
          </span>
          <span *ngIf="!rowData.active" class="isfalse">
            <i matTooltip="In-Active" class="material-icons">thumb_down</i>
          </span>
        </div>

      </td>
    </tr>
  </ng-template>

</p-table>

                        <div class="cus-paginator" [ngClass]="{'empty-record': countryList.length == 0}" fxLayout="row wrap" fxLayoutGap="0px grid" fxLayoutGap.sm="20px grid" fxLayoutGap.xs="20px grid">

                            <div fxFlex="30%" fxFlex.lg="30%" fxFlex.md="30%" fxFlex.sm="100%" fxFlex.xs="100%" fxLayoutAlign="start center"> Showing {{ dt.totalRecords
                                < 1 ? 0 : dt.first + 1 }} - {{ dt.totalRecords> 0 ? dt.rows + dt.first
                                    <=dt.totalRecords ? dt.rows + dt.first : dt.totalRecords : 0 }} of {{ dt.totalRecords }} record(s) | &nbsp; <a (click)="showall()"> Show All</a>
                            </div>
                            <span fxFlex fxHide.md fxHide.sm fxHide.xs></span>
                            <div fxFlex="50%" fxFlex.lg="50%" fxFlex.md="70%" fxFlex.sm="100%" fxFlex.xs="100%" fxLayoutAlign="end center" fxLayoutAlign.md="end center" fxLayoutAlign.sm="start center" fxLayoutAlign.xs="start center">
                                <a [ngClass]="dt.first===0?'page-btn disabled': 'page-btn'" (click)="dt.onPageChange({ first: dt.first - dt.rows, rows: dt.rows });
                                    navigateNxtPrevPage(dt.first + dt.rows,dt.rows)"> <i class="icon-control-start mr-5"></i></a> <span class="gotopagbg mr-2 ml-2" fxHide.xs>Go to Page<span class="input-num">
          <input type="number" #pageNo [(ngModel)]="currentPage" maxlength="5" min="1"
                                            appNumberOnly [NumberOnly]="false"
                                            (keyup.enter)="navigatePage(pageNo.value,dt.rows)" />
          </span></span> <span class="mr-2" fxHide.xs>Of {{ getTotalPages(dt.totalRecords,dt.rows) }}</span> <a [ngClass]="(dt.rows + dt.first)>=dt.totalRecords?'page-btn disabled': 'page-btn'" (click)="dt.onPageChange({ first: dt.first + dt.rows, rows: dt.rows });
                                        navigateNxtPrevPage(dt.first + dt.rows,dt.rows)"><i
                                        class="icon-control-end ml-5"></i></a> </div>
                        </div>

                    </div>
                </div>
            </mat-card-content>
        </mat-card>
    </div>
</div>
<ng-template #deleteConfirmation>
    <mat-dialog-content>
        <div fxLayout="row">
            <div fxFlex="100%">
                <div fxLayout="row">
                    <div fxFlex="100%" fxLayoutAlign="center center" class="mb-15"> <img src="assets/images/alert-warning.gif"> </div>
                </div>
                <div fxLayout="row" fxLayoutAlign="center center">
                    <div fxFlex="100%" class="text-center">
                        <h3 class="m-0">Confirmation !</h3>
                        <p class="text-sm">Are you sure you want to <b>delete</b> thi records?</p>
                    </div>
                </div>
            </div>
        </div>
    </mat-dialog-content>
    <mat-dialog-actions fxLayoutAlign="end center" fxLayoutGap="8px">
        <button mat-stroked-button (click)="dialogRef.close()">No, Keep it</button>
        <button mat-flat-button color="warn" (click)="deleteCountry()">Yes, Delete it</button>
    </mat-dialog-actions>
</ng-template>