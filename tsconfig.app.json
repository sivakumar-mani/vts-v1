{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": [],
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "files": [
    "src/main.ts",
    "src/polyfills.ts",
    "src/typings.d.ts"
  ],
  "exclude": [
    "**/*.spec.ts",
    "**/*.ngtypecheck.ts"
  ]
}
