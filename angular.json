{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "Vts": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "prefix": "app",
      "schematics": {},
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": { "base": "dist/Vts", "browser": "" },
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js", "src/polyfills.ts"],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              "src/config.json",
              "src/silent-refresh.html",
              {
                "glob": "**/*",
                "input": "node_modules/ngx-scanner-qrcode/wasm/",
                "output": "./assets/wasm/"
              }
            ],
            "styles": [
              {
                "input": "node_modules/@progress/kendo-theme-default/dist/all.css",
                "inject": true
              },
              "src/styles.css"
            ],
            "scripts": [
              "src/assets/script/jquery.min.js",
              "src/assets/script/xepOnline.jqPlugin.js"
            ],
            "allowedCommonJsDependencies": [
              "xlsx",
              "xlsx-js-style",
              "exceljs",
              "file-saver",
              "crypto-js",
              "js-sha256",
              "pdfjs-dist",
              "angular-oauth2-oidc"
            ],
            "extractLicenses": false,
            "sourceMap": true,
            "optimization": false
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "15mb",
                  "maximumError": "25mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ]
            }
          },
          "defaultConfiguration": ""
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "Vts:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "Vts:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "Vts:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "src/test.ts",
            "polyfills": ["zone.js", "src/polyfills.ts"],
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "src/karma.conf.js",
            "styles": [
              {
                "input": "node_modules/@progress/kendo-theme-default/dist/all.css",
                "inject": true
              },
              "src/styles.css"
            ],
            "scripts": [],
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ]
          }
        },
      }
    },
    "Vts-e2e": {
      "root": "e2e/",
      "projectType": "application",
      "prefix": "",
      "architect": {
        "e2e": {
          "builder": "@angular-devkit/build-angular:protractor",
          "options": {
            "protractorConfig": "e2e/protractor.conf.js",
            "devServerTarget": "Vts:serve"
          },
          "configurations": {
            "production": {
              "devServerTarget": "Vts:serve:production"
            }
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular": {
      "component": {
        "spec": false
      },
      "class": {
        "spec": false
      },
      "service": {
        "spec": false
      }
    }
  },
  "cli": {
    "analytics": "a8140e26-42c0-46a1-aadc-7d71403c2feb"
  }
}